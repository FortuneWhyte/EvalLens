# Copy to .env and fill in. Every key is optional: with none set, EvalLens
# still runs end to end against the built-in mock provider at zero cost.

# Relational store. SQLite by default; swap for a Postgres URL to scale out.
EVALLENS_DATABASE_URL=sqlite:///./evallens.db

# Providers. Leave a key unset and that provider reports itself unconfigured
# rather than failing at call time.
EVALLENS_OPENAI_API_KEY=
EVALLENS_ANTHROPIC_API_KEY=
EVALLENS_OLLAMA_BASE_URL=http://localhost:11434

# Judge defaults. The judge is pinned and held at temperature zero so scores
# stay comparable across runs; it must differ from the candidate model.
EVALLENS_JUDGE_MODEL=gpt-4.1
EVALLENS_JUDGE_TEMPERATURE=0.0
EVALLENS_RUBRIC_VERSION=r3

# Hard ceiling on spend, in USD. A run that would cross it is refused.
EVALLENS_MONTHLY_SPEND_CAP=50.0

# How many samples to evaluate concurrently. Scoring is IO bound and rate
# limited, so this is the main throughput dial.
EVALLENS_MAX_CONCURRENCY=8
